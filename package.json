{
  "name": "ai-career-roadmap-generator-root",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev:frontend": "cd frontend && npx vite",
    "dev:backend": "cd backend && npx tsx watch src/server.ts",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "prisma:generate": "npx prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate": "npx prisma migrate dev --schema=backend/prisma/schema.prisma",
    "build:frontend": "cd frontend && npx vite build",
    "build:backend": "cd backend && npx tsc",
    "build": "npm run build:backend && npm run build:frontend"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "@prisma/client": "^6.5.0",
    "@tanstack/react-query": "^5.28.9",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.0",
    "cloudinary": "^2.6.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^11.0.24",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.511.0",
    "openai": "^4.86.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.51.2",
    "react-router-dom": "^6.22.3",
    "recharts": "^2.12.3",
    "sanitize-html": "^2.14.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.13.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^8.0.12"
  }
}
